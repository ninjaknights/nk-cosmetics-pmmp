{
  "namespace": "server_form",
  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "vanilla@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 15px",
            10
          ],
          "$title_max_size": [
            "100% - 15px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text = 'NK Cosmetics') or (#title_text = 'NK Cosmetics Preview')))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "catalog@nk_catalog.root": {}
      },
      {
        "catalog_with_preview@nk_catalog.root_with_preview": {}
      }
    ]
  },
  "main_screen_content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "size": [
            "100%",
            "100%"
          ],
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  }
}
